# Copy this file to .env and fill in only the provider you plan to use.
# Never commit real API keys.

# OpenAI-compatible provider configuration
LLM_PROVIDER=openai_compatible

# Exact provider model identifier
LLM_MODEL=gpt-5.6-sol
LLM_BASE_URL=https://api.navy/v1
LLM_API_KEY=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

LLM_REQUEST_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3

# Optional alternate OpenAI-compatible endpoint
LLM_ALTERNATE_MODEL=
LLM_ALTERNATE_BASE_URL=
LLM_ALTERNATE_API_KEY=
